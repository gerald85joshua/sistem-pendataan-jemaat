@using System.Linq;
@using System.Text.Json;
@model HomeViewModel
@{
    ViewData["Title"] = "Dashboard";
    var num = 0;

    string GetBgPoint(string StatusKeaktifanID)
    {
        if (StatusKeaktifanID == "JA")
        {
            return "bg-success";
        }
        else if (StatusKeaktifanID == "JM")
        {
            return "bg-dark";
        }
        else if (StatusKeaktifanID == "JS")
        {
            return "bg-warning";
        }
        else if (StatusKeaktifanID == "JX")
        {
            return "bg-secondary";
        }
        else if (StatusKeaktifanID == "TA")
        {
            return "bg-danger";
        }

        return "bg-white";
    }

    var XLabels = JsonSerializer.Serialize(Model.JemaatChartDataModels.Select(x => x.DimensionOne).ToList());
    var YValues = JsonSerializer.Serialize(Model.JemaatChartDataModels.Select(x => x.Quantity).ToList());
    ViewData["Title"] = "Statistik Jemaat";
}

