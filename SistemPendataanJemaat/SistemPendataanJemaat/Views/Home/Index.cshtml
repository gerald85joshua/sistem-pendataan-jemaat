    <div class="row g-6 mb-6">
        <div class="col-xl-4 col-sm-6 col-8">
            <div class="card shadow border-0 mb-7 pb-2">
                <div class="chart-container">
                    <canvas id="chart" style="width:100%; height:300px"></canvas>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-sm-3 col-4">
            <!-- Button to Open the Modal -->
            <button id="btnOpenModal" type="button" class="btn btn-primary" data-toggle="modal" data-target="#birthdayModal">
                Lihat Ulang Tahun
            </button>
        </div>
    </div>
    @using (Html.BeginForm("Index", "Home", FormMethod.Get))
    {
        <div class="row">
            <div class="col-3">
                <input asp-for="TypedKey" placeholder="Cari nama jemaat.." class="form-control" />
            </div>
            <div class="col-3">
                @Html.DropDownListFor(m => m.SelectedKomsel, Model.DdlKomsel, "Cari komsel..", new { @id = "komsel", @class = "form-control" })
            </div>
        </div>
        <div class="row">
            <div class="col-3">
                @Html.DropDownListFor(m => m.SelectedStatus, Model.DdlStatus, "Cari status jemaat: All", new { @id = "status", @class = "form-control" })
            </div>
            <div class="col-3">
                <input type="hidden" asp-for="SearchTriggered" />
                <input class="btn btn-neutral" type="submit" value="Cari" />
            </div>
        </div>
    }

    @if (Model.VwList.Count == 0)
    {
        <div class="card shadow border-0 mb-7">
            <div class="table-responsive">
                <img src="~/images/BackgroundJemaat.jpg" alt="Jemaat" style="height: 100%; width: 100%; opacity: 0.1;">
            </div>
        </div>
    }
    else
    {
        <div class="card shadow border-0 mb-7">
            <div class="table-responsive">
                <table class="table table-hover table-nowrap">
                    <thead class="thead-light">
                        <tr>
                            <th scope="col">No.</th>
                            <th scope="col">Nama Lengkap</th>
                            <th scope="col">Jenis Kelamin</th>
                            <th scope="col">Komsel</th>
                            <th scope="col">Status Keaktifan</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.VwList)
                        {
                            num++;
                            <tr>
                                <td> @num. </td>
                                <td> @item.Nama_Lengkap </td>
                                <td> @item.Jenis_Kelamin </td>
                                <td> @item.Komsel </td>
                                <td> <span class="badge badge-lg badge-dot"> <i class="@GetBgPoint(item.Status_Keaktifan_ID)"></i>@item.Status_Keaktifan</span> </td>
                                <td> <a asp-action="JemaatDetail" asp-controller="DataJemaat" asp-route-id="@item.ID" class="btn btn-sm btn-neutral">View</a> </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- The Modal -->
<div class="modal fade" id="birthdayModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <span class="icon"><i class="bi bi-cake2"></i> Halaman Ulang Tahun</span>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <div class="row">
                    <div class="col-4">
                        <input asp-for="BirthdayStartDate" id="birthdayStartDate" placeholder="Dari" class="form-control" type="date" />
                    </div>
                    <div class="col-4">
                        <input asp-for="BirthdayEndDate" id="birthdayEndDate" placeholder="Sampai" class="form-control" type="date" />
                    </div>
                </div>
                <br/>
                <div class="row">
                    <div class="col-4">
                        <input id="findBirthday" class="btn btn-neutral" value="Cari" />
                    </div>
                    <div class="col-4">
                        <input onclick="printPopup()" class="btn btn-primary" value="Print" />
                    </div>
                </div>
                <br/>
                <div id="birthdayContent" class="row"></div>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-neutral" data-dismiss="modal">Tutup</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script type="text/javascript">
        function printPopup() {
            const popup = document.getElementById("birthdayModal");
            const originalBody = document.body.innerHTML;

            document.body.innerHTML = popup.innerHTML;
            window.print();
            document.body.innerHTML = originalBody;
        }

        $("#btnOpenModal").click(function () {
            document.getElementById("birthdayModal").style.display = "block";
            $('#birthdayModal').modal('show');
        });

        $("#findBirthday").click(function () {
            var startDate = $("#birthdayStartDate").val();
            var endDate = $("#birthdayEndDate").val();
            // call the action method, in the success function add the return data in the Modal content.
            $.ajax({
                type: "POST",
                url: '@Url.Action("_BirthdayDialog")',  //remember change the controller to your owns.
                cache: false,
                data: { startDate: startDate, endDate: endDate },
                success: function (response) {
                    var content = $('<div />').html(response);
                    $('#birthdayContent').html("");
                    $('#birthdayContent').append(content);
                },
                error: function (response) {
                    console.log(response.responseText);
                }
            });
        });

        $(function () {
            var chartName = "chart";
            var ctx = document.getElementById(chartName).getContext('2d');
            const data = {
                labels: @Html.Raw(XLabels),
                datasets: [{
                    backgroundColor: [
                        'rgba(75, 192, 192, 0.5)',
                        'rgba(255, 99, 132, 0.5)',
                        'rgba(54, 162, 235, 0.5)',
                        'rgba(86, 86, 86, 0.5)',
                        'rgba(153, 102, 255, 0.5)',
                        'rgba(255, 159, 64, 0.5)'
                    ],
                    borderColor: [
                        'rgba(75, 192, 192, 1)',
                        'rgba(255, 99, 132, 1)',
                        'rgba(54, 162, 235, 1)',
                        'rgba(86, 86, 86, 1)',
                        'rgba(153, 102, 255, 1)',
                        'rgba(255, 159, 64, 1)'
                    ],
                    borderWidth: 1,
                    data: @Html.Raw(YValues),
                    hoverOffset: 4
                }]
            };

            var myChart = new Chart(ctx, {
                data: data,
                type: 'pie'
            });
        });
    </script>
}