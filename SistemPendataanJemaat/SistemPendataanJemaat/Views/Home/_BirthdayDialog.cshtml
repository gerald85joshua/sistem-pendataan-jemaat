@model BirthdayDialogViewModel
@{
    var today = DateTime.Today;
    var numDewasa = 0;
    var numPemuda = 0;
    var numAnak = 0;
}

<div id="birthdayContent" class="modal">
    <div class="row">
        <h5>Dewasa</h5>
    </div>
    <div class="row">
        <div class="table-responsive">
            <table class="table table-hover table-nowrap">
                <thead class="thead-light">
                    <tr>
                        <th scope="col">No.</th>
                        <th scope="col">Nama Lengkap</th>
                        <th scope="col">Jenis Kelamin</th>
                        <th scope="col">Umur</th>
                        <th scope="col">Tanggal Lahir</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ListDewasa)
                    {
                        var umur = today.Year - item.Tanggal_Lahir.Year;
                        var tglLahir = item.Tanggal_Lahir.ToString("dd/MM/yyyy");
                        numDewasa++;
                        <tr>
                            <td> @numDewasa. </td>
                            <td> @item.Nama_Lengkap </td>
                            <td> @item.Jenis_Kelamin </td>
                            <td> @umur tahun </td>
                            <td> @tglLahir </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <br/><br/>
    <div class="row">
        <h5>Pemuda</h5>
    </div>
</div>